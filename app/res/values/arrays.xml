<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed 推荐作用域（v2.1.2 修正；v2.7.0 ColorOS 适配扩展；v4.1.0 荣耀适配）：
         android = 系统框架（S1）；com.android.phone = 电话进程（S1 兜底）；
         com.android.mms = AOSP/小米短信应用（S2-S7）；
         com.hihonor.mms = 荣耀「信息」（独立后的包名，S2-S7 同族入口）；
         com.android.providers.telephony = 短信库（S8 主通道）；
         （v4.1.0 起不再推荐小米笔记：写待办走 root 直写库，模块从不 Hook 它，
           实测取消勾选后短信、通知、待办写入全部正常）
         菜鸟、拼多多 = 可选的 App 内包裹提取入口。
         未安装的目标 LSPosed 会自动忽略——各家 App 同时声明互不影响。
         注意：系统框架在旧版 LSPosed 记作 android、2.x 记作 system，两者等价；S8 所在的 providers.telephony 建议勾。 -->
    <string-array name="xposed_scope">
        <item>android</item>
        <item>com.android.phone</item>
        <item>com.android.mms</item>
        <item>com.hihonor.mms</item>
        <item>com.android.providers.telephony</item>
        <item>com.cainiao.wireless</item>
        <item>com.xunmeng.pinduoduo</item>
    </string-array>
</resources>
