<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
<LinearLayout android:id="@+id/rear_content"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp"
    android:background="#000000">
    <TextView android:id="@+id/rear_count" android:layout_width="match_parent"
        android:layout_height="22dp" android:gravity="center_vertical"
        android:textColor="#D6B577" android:textSize="12sp" android:singleLine="true" />
    <TextView android:id="@+id/rear_code" android:layout_width="match_parent"
        android:layout_height="44dp" android:gravity="center_vertical"
        android:fontFamily="sans-serif" android:fontFeatureSettings="tnum"
        android:textColor="#FFFFFF" android:textSize="32sp" android:singleLine="true"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"
        android:includeFontPadding="false" />
    <TextView android:id="@+id/rear_place" android:layout_width="match_parent"
        android:layout_height="40dp" android:gravity="center_vertical"
        android:textColor="#BBBBBB" android:textSize="11sp"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
