<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
<LinearLayout android:id="@+id/rear_content"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="12dp"
    android:background="#000000">
    <TextView android:id="@+id/rear_count" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="#FFFFFF"
        android:textSize="24sp" android:singleLine="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="唤醒背屏查看取件码"
        android:textColor="#BBBBBB" android:textSize="12sp" />
</LinearLayout>
</FrameLayout>
