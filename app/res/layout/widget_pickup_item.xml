<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="visible">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingVertical="2dp" android:layout_marginEnd="10dp">
     <TextView android:id="@+id/widget_code_1" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:fontFamily="sans-serif" android:fontFeatureSettings="tnum" android:textSize="22sp" android:singleLine="true" android:includeFontPadding="false" android:textColor="@color/widget_code_ink"/>
     <TextView android:id="@+id/widget_place_1" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical" android:includeFontPadding="false" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/widget_muted"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_done_1" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:src="@drawable/ic_widget_done" android:tint="@color/widget_action" android:contentDescription="标记已取件"/>
   </LinearLayout>
