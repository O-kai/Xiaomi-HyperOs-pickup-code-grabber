<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
 <LinearLayout android:id="@+id/widget_root_v2" android:orientation="vertical" android:gravity="top|start" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
  <FrameLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="24dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="4dp" android:layout_height="12dp" android:layout_marginEnd="8dp" android:background="@drawable/widget_marker" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="取件码" android:textSize="15sp" android:includeFontPadding="false" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginStart="8dp" android:paddingHorizontal="7dp" android:gravity="center" android:text="0 件待取" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_accent" android:background="@drawable/widget_count_bg"/>
    <ImageView android:id="@+id/widget_open_icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="10dp" android:src="@drawable/ic_widget_open" android:tint="@color/widget_muted" android:importantForAccessibility="no"/>
   </LinearLayout>
  </FrameLayout>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="都取完了，轻松出门" android:textSize="13sp" android:textColor="@color/widget_muted" android:visibility="gone"/>
  <ListView android:id="@+id/widget_list" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:stackFromBottom="false"
      android:transcriptMode="disabled" android:divider="@android:color/transparent"
      android:dividerHeight="0dp" android:scrollbars="vertical" android:overScrollMode="never"
      android:clipToPadding="true" android:contentDescription="取件包裹列表，可上下滑动"/>
 </LinearLayout>
</FrameLayout>
