<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v2.5.1：唯一联网行为 = 检查更新（3 天一次，GitHub Releases API），无其他网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 取件提醒：开机后重注册每日闹钟（AlarmManager 的闹钟不跨重启） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- v2.7.0：包可见性声明（Android 11+），保证后端探测能准确找到各 ROM 的目标 App -->
    <queries>
        <package android:name="com.coloros.note" />
        <package android:name="com.miui.notes" />

        <!--
          v4.4：允许看到「有桌面入口」的应用。
          用户可以在「通知提取 → 添加自定义来源 → 从已安装选择」里挑任意 App 加进白名单。
          Android 11+ 的包可见性机制下，不声明这条 queries，queryIntentActivities 只能看到
          上面显式列出的两个包，列表会是空的——这正是「点从已安装选择什么也读不到」的原因。
          这里只声明「能查询 LAUNCHER 类应用」，不是 QUERY_ALL_PACKAGES 那种全量权限，
          范围可控，也不涉及敏感数据。
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="取件码助手"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Xposed/LSPosed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="自动提取快递取件码，写入待办（小米笔记 / ColorOS 日历·便签，自动识别）" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 跨进程事实入口：Hook 进程通过 ContentResolver.call 唤醒模块 App；
             调用方由 CallerPolicy 按 UID/包名校验，见 TodoProvider.java -->
        <provider
            android:name=".TodoProvider"
            android:authorities="io.github.okaidev.pickupcode.provider"
            android:exported="true" />

        <!-- v3.0.0：全部页面使用无系统标题栏主题，避免与页面自绘头部重复 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知动作受控入口：exported=false，只允许本 App 的 PendingIntent 启动 -->
        <activity
            android:name=".NotificationActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 4.0 本地取件列表 -->
        <activity
            android:name=".PickupListActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 4.0 小组件外观设置（字号 / 地点 / 条数） -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 4.0 桌面小组件 -->
        <receiver
            android:name=".PickupWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pickup_widget_info" />
        </receiver>

        <!-- 小组件动作入口：exported=false -->
        <activity
            android:name=".WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 打赏页（v2.5.0）：右上角菜单进入，不对外暴露 -->
        <activity
            android:name=".DonateActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- 用户自定义规则（v3.0.0 高级功能）：仅主界面卡片进入，不对外暴露 -->
        <activity
            android:name=".UserRulesActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:label="用户自定义规则" />

        <!-- 取件提醒：每日闹钟（仅本 App 可触发，外部无法伪造） -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.okaidev.pickupcode.action.REMINDER" />
            </intent-filter>
        </receiver>

        <!-- 开机后重排提醒（系统广播，唯一必须 exported 的接收器） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 一键链路测试（v3.0.0）：主界面按钮进入，验证「识别→写入」全链路 -->
        <activity
            android:name=".ChainTestActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:label="一键链路测试" />
    </application>
</manifest>
