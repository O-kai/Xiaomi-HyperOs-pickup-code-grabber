  "notifyOnlyPhrases": [
    "商品待取件提醒", "订单发货通知", "商品派送通知",
    "订单签收提醒", "订单物流", "订单已送达",
    "包裹已寄出", "骑士正在配送", "骑士已接单", "商家已接单",
    "商品退货提醒", "上门取件"
  ]
}
