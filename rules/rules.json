{
  "version": 3,
  "minAppVersionCode": 290,
  "description": "取件码提取规则集 v3（支持正反向过滤：排除已超/超时/滞留等催取误报，码形增强，地点双策略，来源括号自解析）",
  "featureWords": [
    "驿站", "快递柜", "丰巢", "菜鸟", "包裹", "取件", "取货", "自提",
    "到站", "已到", "送达", "兔喜", "妈妈驿站", "中邮", "熊猫快收", "收发室", "快递", "代收", "欢猫驿站"
  ],
  "actionWords": [
    "领取", "取出", "凭", "取件", "取货", "及时", "尽快", "速取", "凭码", "出示"
  ],
  "keywordAnchors": [
    "取件码", "取货码", "提取码", "自提码", "凭码", "动态取件码", "取件号", "凭取件码"
  ],
  "byWords": [
    "凭", "出示"
  ],
  "dashPattern": "(?:[A-Za-z]-\\d{1,6}|[A-Za-z]?\\d{1,6})(?:-[A-Za-z]?\\d{1,6}){0,3}",
  "alnumPattern": "[A-Za-z]?\\d{3,9}",
  "placePrefixes": [
    "已到站[，,包到至\\s]*", "已到达", "到达", "已到", "到", "在", "至"
  ],
  "placeSuffixes": [
    "店", "站", "柜", "点", "自提", "快递", "门面房", "小平房", "中心", "驿站", "服务", "广场"
  ],
  "negativeKeywords": [
    "已超", "超时", "滞留", "损坏", "催取", "延期", "保管费"
  ]
}
