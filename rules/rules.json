{
  "version": 7,
  "minAppVersionCode": 293,
  "description": "取件码提取规则集 v7（① 码形放宽：支持双字母前缀 CC3-3214 与中间纯字母段 1023-a-66，修复 GitHub issue #11 / #10 漏抓；② 沿用 v6 的驿站品牌特征词与后瞻引导字；③ 保留严格码形 + 正反双向闸门，订单号/英文邮箱等反例不入库）",
  "featureWords": [
    "驿站", "快递柜", "丰巢", "菜鸟", "包裹", "取件", "取货", "自提",
    "到站", "送达", "兔喜", "妈妈驿站", "中邮", "熊猫快收", "收发室", "快递", "代收",
    "欢猫驿站", "驿收发", "驿小哥", "快宝", "小兵驿站", "邻里驿站", "菜鸟驿站"
  ],
  "extraFeatureWords": [],
  "actionWords": [
    "领取", "取出", "凭", "取件", "取货", "及时", "尽快", "速取", "凭码", "出示"
  ],
  "keywordAnchors": [
    "取件码", "取货码", "提货码", "提取码", "自提码", "凭码", "动态取件码", "取件号", "凭取件码",
    "取货号", "提货号", "收货码", "取件密码"
  ],
  "byWords": ["凭", "出示"],
  "byLookaheadWords": ["到", "至", "去", "取", "领", "票", "免", "可", "即", "立", "自", "请", "务"],
  "dashPattern": "(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})(?:-(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})){1,3}|(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})(?:-[A-Za-z]{1,2})(?:-(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})){1,2}",
  "alnumPattern": "[A-Za-z]?\\d{3,9}",
  "placePrefixes": [
    "已到站[，,包到至\\s]*", "已到达", "到达", "已到", "到", "在", "至"
  ],
  "placeSuffixes": [
    "店", "站", "柜", "点", "自提", "快递", "门面房", "小平房", "中心",
    "驿站", "服务", "广场", "速递", "格口", "门店"
  ],
  "negativeKeywords": [
    "卡券", "话费券", "红包", "积分", "商城", "兑换", "充值", "话费", "流量",
    "账户", "余额", "验证码", "银行", "信用卡", "贷款",
    "骑手", "外卖", "闪购", "免单", "客服", "退订",
    "实验室", "激光共聚焦", "生物",
    "已超", "滞留", "损坏", "延期", "保管费"
  ],
  "excludeTailWords": [
    "号", "栋", "楼", "室", "层", "格", "元", "折", "天", "小时",
    "分钟", "秒", "岁", "次", "个", "件", "单", "米", "折券"
  ],
  "excludeHeadWords": [
    "超", "满", "过", "低至", "高达", "第", "共", "计", "约", "近", "余", "剩",
    "单号", "订单号", "订单", "运单", "快递单", "尾号"
  ]
}
