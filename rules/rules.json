  "byWords": ["凭", "出示"],
  "byLookaheadWords": ["到", "至", "去", "取", "领", "票", "免", "可", "即", "立", "自", "请", "务"],
  "dashPattern": "(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})(?:-(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})){1,3}|(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})(?:-[A-Za-z]{1,2})(?:-(?:[A-Za-z]{1,2}-\\d{1,6}|[A-Za-z]{0,2}\\d{1,6})){1,2}",
  "alnumPattern": "[A-Za-z]?\\d{3,9}",
  "placePrefixes": [
    "已到站[，,包到至\\s]*", "已到达", "到达", "已到", "到", "在", "至"
  ],
  "placeSuffixes": [
    "店", "站", "柜", "点", "自提", "快递", "门面房", "小平房", "中心",
    "驿站", "服务", "广场", "速递", "格口", "门店"
