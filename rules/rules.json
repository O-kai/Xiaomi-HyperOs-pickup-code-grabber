  "negativeKeywords": [
    "卡券", "话费券", "红包", "积分", "商城", "兑换", "充值", "话费", "流量",
    "账户", "余额", "验证码", "银行", "信用卡", "贷款",
    "骑手", "外卖", "闪购", "免单", "客服", "退订",
    "实验室", "激光共聚焦", "生物",
    "已超", "滞留", "损坏", "延期", "保管费"
  ],
  "excludeTailWords": [
    "号",
    "栋",
    "楼",
    "室",
    "层",
    "格",
    "元",
    "折",
    "天",
    "小时",
    "分钟",
    "秒",
    "岁",
    "次",
    "个",
    "件",
    "单",
    "米",
    "折券"
