{
  "version": 11,
  "minAppVersionCode": 405,
  "description": "取件码提取规则集 v11（① 纯状态通知词表按真机 20 条错题样本扩充：订单签收提醒 / 订单物流 / 骑士接单 / 商家已接单 / 包裹已寄出 / 商品退货提醒 等，这类没有取件码的进度通知整条跳过；② v10 的「凭 A，B 等取件码」多码拆分照旧）",
  "featureWords": [
    "驿站", "快递柜", "丰巢", "菜鸟", "包裹", "取件", "取货", "自提",
    "到站", "送达", "兔喜", "妈妈驿站", "中邮", "熊猫快收", "收发室", "快递", "代收",
    "欢猫驿站", "驿收发", "驿小哥", "快宝", "小兵驿站", "邻里驿站", "菜鸟驿站"
  ],
  "extraFeatureWords": [],
